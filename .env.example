# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend / Database ---
DATABASE_URL=postgresql://energy_user:energy_pass@postgres:5432/energy_monitor
POWER_THRESHOLD_W=2000
DEVICE_OFFLINE_AFTER_SECONDS=30
CORS_ORIGINS=http://localhost:3000

# --- MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Postgres (used by docker-compose to init the DB) ---
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=energy_pass
POSTGRES_DB=energy_monitor

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
